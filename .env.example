# Firebase Web アプリの設定（値は Firebase コンソールで Web アプリを登録すると発行される）
# このファイルを .env.local にコピーして実値を入れること。.env.local は Git にコミットしない。
# ここに書くのは公開可能な Web 用キーだが、実値はこのサンプルには入れない。

VITE_FIREBASE_API_KEY=__YOUR_API_KEY__
VITE_FIREBASE_AUTH_DOMAIN=__YOUR_PROJECT_ID__.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=medipro-capillary-scope
VITE_FIREBASE_STORAGE_BUCKET=__YOUR_PROJECT_ID__.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=__YOUR_SENDER_ID__
VITE_FIREBASE_APP_ID=__YOUR_APP_ID__

# Cloud Functions のリージョン（プロジェクト作成時に決める。東京は asia-northeast1）
VITE_FIREBASE_FUNCTIONS_REGION=asia-northeast1
